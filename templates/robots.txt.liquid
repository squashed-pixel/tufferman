{% for group in robots.default_groups %}
  {{- group.user_agent }}

  {%- for rule in group.rules -%}
    {{ rule }}
  {%- endfor -%}

  {%- comment -%} Custom: block product recommendation tracking URLs to reduce crawl waste {%- endcomment -%}
  {%- if group.user_agent.value == '*' -%}
    {{ 'Disallow: /*pr_prod_strat=' }}
  {%- endif -%}

  {%- if group.sitemap != blank -%}
    {{ group.sitemap }}
  {%- endif -%}
{% endfor %}